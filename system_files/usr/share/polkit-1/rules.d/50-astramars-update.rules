// AstraMars Store: администраторы проверяют и скачивают обновления системы без пароля.
// Разрешён только запуск двух служб с фиксированной командой bootc (см. /usr/libexec/astramars-update).
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    if (!subject.local || !subject.active || !subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if ((unit === "astramars-update-check.service" || unit === "astramars-update-apply.service") &&
        verb === "start") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
