// AstraMars VPN: администраторы могут включать и выключать свой VPN без ввода пароля.
// Разрешено только управление собственной службой astramars-vpn@<имя>.service
// и мгновенное применение системного прокси (astramars-proxy.service).
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    if (!subject.local || !subject.active || !subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");

    if (unit === "astramars-vpn@" + subject.user + ".service" &&
        (verb === "start" || verb === "stop" || verb === "restart")) {
        return polkit.Result.YES;
    }
    if (unit === "astramars-proxy.service" && verb === "start") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
